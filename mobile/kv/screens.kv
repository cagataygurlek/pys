<BordroScreen>:
    MDBoxLayout:
        orientation: 'vertical'

        MDTopAppBar:
            title: "Bordro"
            left_action_items: [['arrow-left', lambda x: root.go_back()]]
            elevation: 2

        MDBoxLayout:
            size_hint_y: None
            height: dp(48)
            padding: dp(8)
            spacing: dp(8)

            MDLabel:
                id: year_label
                text: "2026"
                halign: 'center'
                font_style: 'H6'

            MDLabel:
                id: month_label
                text: "6"
                halign: 'center'
                font_style: 'H6'

        MDScrollView:
            MDBoxLayout:
                orientation: 'vertical'
                padding: dp(16)
                spacing: dp(8)

                MDLabel:
                    text: "Bordro sayfası yakında eklenecek"
                    halign: 'center'
                    theme_text_color: 'Secondary'

